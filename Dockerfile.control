FROM node:22.22.0-alpine
ARG REVISION
ENV NODE_ENV=production
WORKDIR /app
COPY --chown=10001:10001 control/ ./control/
RUN addgroup -g 10001 control && adduser -D -u 10001 -G control control \
    && test -n "$REVISION" && printf '{"revision":"%s"}\n' "$REVISION" > /app/release.json
USER 10001:10001
EXPOSE 8081
HEALTHCHECK --interval=5s --timeout=3s --retries=12 CMD node -e "fetch('http://127.0.0.1:8081/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "control/server.mjs"]
